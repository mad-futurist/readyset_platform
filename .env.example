ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://readyset:readyset@localhost:5432/readyset
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
PASSWORD_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
INVITATIONS_ENABLED=true
DEVELOPMENT_TOKEN_EXPOSURE=true
UPLOADS_ENABLED=true

# Development may use memory/noop. Staging/production requires redis/clamav.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_KEY_PREFIX=readyset:rate-limit
SCANNER_BACKEND=noop
CLAMAV_HOST=
CLAMAV_PORT=3310

# Development/test captures messages in memory. Staging/production requires smtp.
EMAIL_BACKEND=capture
EMAIL_FROM=ReadySet <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Google OAuth / OIDC (optional locally; required to exercise Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# S3-compatible storage / MinIO
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=readyset
STORAGE_SECRET_KEY=readyset-local-only
STORAGE_BUCKET=readyset-documents
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_ENCRYPTION=none
STORAGE_KMS_KEY_ID=
MAX_UPLOAD_BYTES=26214400
ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Web container only
API_INTERNAL_URL=http://api:8000
