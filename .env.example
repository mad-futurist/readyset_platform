ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://readyset:readyset@localhost:5432/readyset
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
PASSWORD_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
INVITATIONS_ENABLED=true
DEVELOPMENT_TOKEN_EXPOSURE=true
UPLOADS_ENABLED=true

# Development may use memory/noop. Staging/production requires redis/clamav.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_KEY_PREFIX=readyset:rate-limit
# Enable only when the API's immediate peer is within one of these networks.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
SCANNER_BACKEND=noop
CLAMAV_HOST=
CLAMAV_PORT=3310

# Development/test captures messages in memory by default. For the optional
# Compose Mailpit profile use smtp, host mailpit, port 1025, and no STARTTLS.
EMAIL_BACKEND=capture
EMAIL_FROM=ReadySet <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Google OAuth / OIDC (optional locally; required to exercise Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# S3-compatible storage / MinIO
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=readyset
STORAGE_SECRET_KEY=readyset-local-only
STORAGE_BUCKET=readyset-documents
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_ENCRYPTION=none
STORAGE_KMS_KEY_ID=
MAX_UPLOAD_BYTES=26214400
ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Web container only
API_INTERNAL_URL=http://api:8000

# AI is opt-in. Explicit local fake providers do not spend credits.
AI_ENABLED=false
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-hash-v1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TOKENIZER=cl100k_base
CHAT_PROVIDER=fake
CHAT_MODEL=fake-evidence-v1
CHAT_TOKENIZER=cl100k_base
# Set via secret manager only for approved production provider use.
OPENAI_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=30
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_SECONDS=10
EXTRACTION_MAX_CHARACTERS=2000000
EXTRACTION_MAX_BLOCKS=20000
EXTRACTION_MAX_PAGES=1000
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=800
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_CONTEXT_TOKENS=6000
RETRIEVAL_PER_CHUNK_TOKENS=800
CHAT_ANSWER_TOKENS=1000
