ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://readyset:readyset@localhost:5432/readyset
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Google OAuth / OIDC (optional locally; required to exercise Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# S3-compatible storage / MinIO
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=readyset
STORAGE_SECRET_KEY=readyset-local-only
STORAGE_BUCKET=readyset-documents
STORAGE_REGION=us-east-1
MAX_UPLOAD_BYTES=26214400
ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Web container only
API_INTERNAL_URL=http://api:8000
